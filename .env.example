# PlateRoute Merchant App — environment template
# Copy to `.env` (cp .env.example .env) and fill real values.
# NEVER commit .env — it is gitignored. 10.0.2.2 = Android emulator loopback to host.

# Backend REST API (Django + DRF, /api/v1/)
API_BASE_URL=http://10.0.2.2:8000/api/v1/

# WebSocket channels (order-board deltas, accept countdowns)
WS_BASE_URL=ws://10.0.2.2:8000/ws

# Error tracking (release-tagged; leave empty for dev)
SENTRY_DSN=

# FCM high-priority data messages drive the incoming-order alarm (MOB-RST-04).
# GoogleService-Info / google-services.json are per-flavor files, not env entries.
